# =============================================================================
# ШАБЛОН окружения для AmneziaWG 3.1 (myceliummesh/amneziawg-ui:3.1).
# Рабочий файл: cp .env.example .env  — .env в git не коммитится.
#
# Обфускация 3.1 (HeaderProtectionKey, RandomTrailers и т.д.) включается
# панелью при создании сервера; через .env задаются только дефолты и доступ к UI.
# Клиент: AmneziaVPN ≥ 5.0.1.5 (или совместимый AWG 3.1).
# =============================================================================

# -----------------------------------------------------------------------------
# WEB_UI_* — вход в веб-панель (basic auth). Читаются только при старте контейнера.
#
# WEB_UI_PASSWORD — НЕ сам пароль, а base64(SHA-256(пароль)):
#   printf 'ваш-пароль' | openssl dgst -binary -sha256 | base64
#
# Ниже — хэш для пароля changeme (смените до публикации UI наружу).
# -----------------------------------------------------------------------------
WEB_UI_USER=admin
WEB_UI_PASSWORD=BXugPWxEEEhj3HNh/kV4ll0YhzYPkKCJWILlimJI/IY=
WEB_UI_PORT=54845

# -----------------------------------------------------------------------------
# DEFAULT_PORT — UDP-порт VPN по умолчанию для НОВЫХ серверов в UI.
# Именно этот порт пробрасывается в docker-compose.yml.
#
# Примеры:
#   DEFAULT_PORT=54844   — дефолт образа
#   DEFAULT_PORT=443     — UDP 443 (часто меньше режут; стыкуется с QUIC по порту)
# -----------------------------------------------------------------------------
DEFAULT_PORT=443

# -----------------------------------------------------------------------------
# Дефолты для новых серверов в панели (можно переопределить в UI).
# MTU=1280 рекомендуется для AWG 3.1.
# -----------------------------------------------------------------------------
DEFAULT_MTU=1280
DEFAULT_SUBNET=10.12.14.0/24
DEFAULT_DNS=1.1.1.1,1.0.0.1

# -----------------------------------------------------------------------------
# AUTO_START_SERVERS — поднимать ранее созданные туннели при старте контейнера.
# -----------------------------------------------------------------------------
AUTO_START_SERVERS=true

# -----------------------------------------------------------------------------
# WEB_UI_PPROF — /debug/pprof за той же basic auth (обычно false).
# -----------------------------------------------------------------------------
WEB_UI_PPROF=false
